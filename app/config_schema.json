{
  "description": "Application settings schema.",
  "properties": {
    "CONTEXTUAL_RENAMING": {
      "default": false,
      "title": "Contextual Renaming",
      "type": "boolean"
    },
    "AI_ASSISTED_NAMING": {
      "default": false,
      "title": "Ai Assisted Naming",
      "type": "boolean"
    },
    "PRESERVE_HIERARCHY": {
      "default": false,
      "title": "Preserve Hierarchy",
      "type": "boolean"
    },
    "MAX_FOLDERS": {
      "default": 12,
      "exclusiveMinimum": 0,
      "maximum": 50,
      "title": "Max Folders",
      "type": "integer"
    },
    "MAX_WORKERS": {
      "default": 4,
      "exclusiveMinimum": 0,
      "maximum": 64,
      "title": "Max Workers",
      "type": "integer"
    },
    "MAX_DEPTH": {
      "default": 5,
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Max Depth",
      "type": "integer"
    },
    "MAX_FEATURES": {
      "default": 3,
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Max Features",
      "type": "integer"
    },
    "CLEANUP_EMPTY_FOLDERS": {
      "default": true,
      "title": "Cleanup Empty Folders",
      "type": "boolean"
    },
    "EXPLORER_INTEGRATION": {
      "default": false,
      "title": "Explorer Integration",
      "type": "boolean"
    },
    "KEYWORD_RULES": {
      "additionalProperties": true,
      "title": "Keyword Rules",
      "type": "object"
    },
    "LEARNED_RULES": {
      "additionalProperties": true,
      "title": "Learned Rules",
      "type": "object"
    },
    "POLICIES": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Policies",
      "type": "array"
    },
    "VISUAL_TIMEOUT": {
      "default": 30,
      "exclusiveMinimum": 0,
      "title": "Visual Timeout",
      "type": "integer"
    },
    "IMAGE_MAX_DIMENSION": {
      "default": 1000,
      "exclusiveMinimum": 0,
      "title": "Image Max Dimension",
      "type": "integer"
    },
    "IMAGE_SKIP_THRESHOLD": {
      "default": 3000,
      "exclusiveMinimum": 0,
      "title": "Image Skip Threshold",
      "type": "integer"
    },
    "MODEL_THREADS": {
      "default": 2,
      "maximum": 32,
      "minimum": 1,
      "title": "Model Threads",
      "type": "integer"
    },
    "PROTECTED_PATHS": {
      "items": {
        "type": "string"
      },
      "title": "Protected Paths",
      "type": "array"
    },
    "PROXY": {
      "default": "",
      "title": "Proxy",
      "type": "string"
    },
    "OCR_GPU_ENABLED": {
      "default": false,
      "title": "Ocr Gpu Enabled",
      "type": "boolean"
    },
    "AUDIO_GPU_ENABLED": {
      "default": false,
      "title": "Audio Gpu Enabled",
      "type": "boolean"
    },
    "OCR_LANGUAGES": {
      "default": "en",
      "title": "Ocr Languages",
      "type": "string"
    },
    "CONFLICT_POLICY": {
      "default": "rename",
      "enum": [
        "skip",
        "rename"
      ],
      "title": "Conflict Policy",
      "type": "string"
    },
    "SORTING_STRATEGY": {
      "default": "default",
      "enum": [
        "default",
        "generative",
        "clinical_tmf",
        "clinical_isf"
      ],
      "title": "Sorting Strategy",
      "type": "string"
    },
    "CLINICAL_SMART_RENAMING": {
      "default": false,
      "title": "Clinical Smart Renaming",
      "type": "boolean"
    },
    "CLINICAL_GENERATE_AUDIT_REPORT": {
      "default": true,
      "title": "Clinical Generate Audit Report",
      "type": "boolean"
    },
    "COHERENCE_THRESHOLD": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Coherence Threshold",
      "type": "number"
    },
    "DEBOUNCE_DELAY": {
      "default": 0.6,
      "exclusiveMinimum": 0.0,
      "title": "Debounce Delay",
      "type": "number"
    },
    "MAX_DEBOUNCE_DELAY": {
      "default": 5.0,
      "exclusiveMinimum": 0.0,
      "title": "Max Debounce Delay",
      "type": "number"
    },
    "IGNORED_EXTENSIONS": {
      "default": [
        ".crdownload",
        ".tmp",
        ".download"
      ],
      "items": {
        "minLength": 1,
        "pattern": "^\\..+",
        "type": "string"
      },
      "title": "Ignored Extensions",
      "type": "array"
    },
    "AI_CONSENT_GRANTED": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ai Consent Granted"
    },
    "LOG_FILE": {
      "default": "autosorter.log",
      "minLength": 1,
      "title": "Log File",
      "type": "string"
    },
    "STOP_WORDS": {
      "default": [
        "about",
        "all",
        "also",
        "and",
        "are",
        "because",
        "been",
        "but",
        "can",
        "com",
        "could",
        "csv",
        "docx",
        "don",
        "for",
        "from",
        "get",
        "has",
        "have",
        "how",
        "inc",
        "into",
        "like",
        "much",
        "nan",
        "not",
        "only",
        "other",
        "out",
        "over",
        "page",
        "pdf",
        "should",
        "site",
        "some",
        "team",
        "than",
        "that",
        "the",
        "their",
        "there",
        "these",
        "this",
        "through",
        "txt",
        "unnamed",
        "was",
        "well",
        "what",
        "when",
        "where",
        "which",
        "who",
        "will",
        "with",
        "would",
        "xls",
        "xlsx",
        "your"
      ],
      "items": {
        "type": "string"
      },
      "title": "Stop Words",
      "type": "array",
      "uniqueItems": true
    }
  },
  "title": "Settings",
  "type": "object"
}
