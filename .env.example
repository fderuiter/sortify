# ==============================================================================
# Smart AutoSorter AI Pro - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the root application directory to customize settings.
# All settings defined in this file take precedence over application defaults.

# ------------------------------------------------------------------------------
# Offline Model Path Overrides
# ------------------------------------------------------------------------------
# Custom path override for the primary offline semantic embedding model bundle (e.g. all-MiniLM-L6-v2)
MODEL_PATH=

# Custom path override for the Florence-2 vision processor model bundle
FLORENCE_2_PATH=

# Custom path override for the EasyOCR model directory
EASYOCR_PATH=

# Custom legacy path override for the EasyOCR module/model directory
EASYOCR_MODULE_PATH=

# ------------------------------------------------------------------------------
# Core Application & Sorting Parameters
# ------------------------------------------------------------------------------
# Enable contextual renaming based on document semantics (true/false)
CONTEXTUAL_RENAMING=false

# Enable AI-assisted folder naming (true/false)
AI_ASSISTED_NAMING=false

# Preserve input directory hierarchy during sorting (true/false)
PRESERVE_HIERARCHY=false

# Maximum number of target folders to generate (1-50)
MAX_FOLDERS=12

# Maximum parallel worker processes (1-64)
MAX_WORKERS=4

# Maximum folder traversal depth (1-10)
MAX_DEPTH=5

# Maximum feature vectors per cluster (1-10)
MAX_FEATURES=3

# Remove empty source directories after file operations (true/false)
CLEANUP_EMPTY_FOLDERS=true

# Enable Windows Explorer context menu integration (true/false)
EXPLORER_INTEGRATION=false

# Visual processing timeout in seconds (>0)
VISUAL_TIMEOUT=30

# Maximum image dimension for visual analysis in pixels (>0)
IMAGE_MAX_DIMENSION=1000

# Image size skip threshold in KB (>0)
IMAGE_SKIP_THRESHOLD=3000

# Number of CPU threads dedicated to model inference (1-32)
MODEL_THREADS=2

# Network proxy URL (e.g. http://proxy.enterprise.com:8080)
PROXY=

# Enable GPU acceleration for OCR processing (true/false)
OCR_GPU_ENABLED=false

# Enable GPU acceleration for audio transcription (true/false)
AUDIO_GPU_ENABLED=false

# Comma-separated language codes for OCR processing (e.g. en,de,fr)
OCR_LANGUAGES=en

# Conflict policy for duplicate filenames (rename / skip)
CONFLICT_POLICY=rename

# Document sorting strategy (default, generative, clinical_tmf, clinical_isf)
SORTING_STRATEGY=default

# Enable clinical smart renaming for medical/trial documents (true/false)
CLINICAL_SMART_RENAMING=false

# Generate audit report for clinical document sorting (true/false)
CLINICAL_GENERATE_AUDIT_REPORT=true

# Coherence threshold score for semantic clustering (0.0 to 1.0)
COHERENCE_THRESHOLD=0.5

# Debounce delay for file system events in seconds (>0.0)
DEBOUNCE_DELAY=0.6

# Maximum debounce delay in seconds (>0.0)
MAX_DEBOUNCE_DELAY=5.0

# User AI consent state (true/false/null)
AI_CONSENT_GRANTED=

# Log file output location
LOG_FILE=autosorter.log
